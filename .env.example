# Logging Configuration
VERBOSE=false                            # Enable detailed debug logs

# Discovery Server Configuration
# Where services should look for the discovery server
# DISCOVERY_URL=http://localhost:8000
# DISCOVERY_URL=http://192.168.0.163:8000           # Remote discovery server
DISCOVERY_URL=https://relatorintegrationtest-production.up.railway.app # Production domain

# Discovery Server Authentication
# API key for accessing discovery server endpoints (prevents unauthorized access)
DISCOVERY_API_KEY=your-api-key-here

# Service IP Override (optional)
# Force services to register with a specific IP if auto-detection fails
# Useful for WSL, Docker, or multi-homed machines
# SERVICE_HOST_IP=localhost           # Your actual accessible IP

# Service Binding Override (optional)
# Force to send messages to these address (use in case discovery server is not working)
# Default: 0.0.0.0 (all interfaces) with standard ports
# MODULE_B_HOST=0.0.0.0:50052            # Event processor
# MODULE_C_HOST=0.0.0.0:50053            # Text-to-speech  
# MODULE_D_HOST=0.0.0.0:50054            # Audio player

# AZURE CLIENT
API_KEY = your-api-key-here
ENDPOINT = https://football-commentator.openai.azure.com/
DEPLOYMENT = gpt-4.1-nano

# OLLAMA CLIENT
# ENDPOINT = http://localhost:11434/v1
# DEPLOYMENT = fine-tuned